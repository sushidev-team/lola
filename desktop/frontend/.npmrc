# Refuse to install package versions published less than 7 days (10080 minutes)
# ago, reducing exposure to freshly compromised or malicious releases.
# Honoured by pnpm and bun; npm currently has no native support and ignores it,
# so this is harmless today and forward-compatible.
minimum-release-age=10080

# NO AUDIT, NO FUND ON INSTALL. Measured on this project: a no-op `npm install`
# — lockfile unchanged, node_modules already complete — takes 4m13s with audit
# on and 0.46s with it off, spending the whole time waiting on the registry at
# 0% CPU.
#
# That is not a background annoyance. `wails3 dev` runs the frontend task
# (install, then vite) in the BACKGROUND while polling http://localhost:9245 a
# handful of times, so a four-minute install guarantees the poll gives up:
#
#   unable to connect to frontend server. Please check it is running
#
# which reads as a broken dev server rather than as npm still working. Every
# `make desktop-dev` paid it.
#
# Turning audit off here is not dropping the check, it is moving it: an audit
# on every dev start is noise nobody reads, and `npm audit` remains available
# to run deliberately. minimum-release-age above is the actual supply-chain
# control, and it is unaffected.
audit=false
fund=false
