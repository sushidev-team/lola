      "frame": {
        "v": 2,
        "type": "err",
        "id": "p1",
        "payload": {
          "code": "pair_rejected",
          "message": "pairing was rejected"
        }
      },
      "hex": "000000627b2276223a322c2274797065223a22657272222c226964223a227031222c227061796c6f6164223a7b22636f6465223a22706169725f72656a6563746564222c226d657373616765223a2270616972696e67207761732072656a6563746564227d7d"
