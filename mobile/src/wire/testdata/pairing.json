{
  "note": "Golden vectors for the remote.pair handshake and the ready frame, envelope v2. Same schema as frames.json; req_remote_pair lives only here. Function vectors (proof, code, QR payload) are internal/protocol/testdata/pairing_vectors.json.",
  "cases": [
    {
      "name": "req_remote_pair",
      "why": "The only frame an unpaired certificate may send, within the handshake timeout. The proof here is a fixed test value; a real one is HMAC-SHA256 over a TLS exporter and is never reused. The ONLY home of this vector.",
      "frame": {
        "v": 2,
        "type": "req",
        "id": "p1",
        "cmd": "remote.pair",
        "payload": {
          "proof": "dGVzdC1wcm9vZi1ub3QtcmVhbC1wcm9vZi12YWx1ZTAw",
          "name": "Dev iPhone",
          "platform": "ios"
        }
      },
      "hex": ""
    },
    {
      "name": "resp_pair_result",
      "why": "An accepted pairing without a relay credential: relay is omitted.",
      "frame": {
        "v": 2,
        "type": "resp",
        "id": "p1",
        "payload": {
          "ok": true,
          "data": {
            "deviceId": "dd3f0a91c2b84e57",
            "name": "Dev iPhone",
            "tiers": [
              "read",
              "answer"
            ],
            "host": "studio.local"
          }
        }
      },
      "hex": ""
    },
    {
      "name": "resp_pair_result_relay",
      "why": "An accepted pairing with the device's own relay credential. The values are placeholders.",
      "frame": {
        "v": 2,
        "type": "resp",
        "id": "p1",
        "payload": {
          "ok": true,
          "data": {
            "deviceId": "dd3f0a91c2b84e57",
            "name": "Dev iPhone",
            "tiers": [
              "read",
              "answer",
              "control"
            ],
            "host": "studio.local",
            "relay": {
              "rv": "rv-placeholder-0000000000000000",
              "bearer": "bearer-placeholder-000000000000000000000000"
            }
          }
        }
      },
      "hex": ""
    },
    {
      "name": "err_pair_failed",
      "why": "Pairing refused: bad proof, closed window or another phone confirming. The message never says which.",
      "frame": {
        "v": 2,
        "type": "err",
        "id": "p1",
        "payload": {
          "code": "pair_failed",
          "message": "pairing failed"
        }
      },
      "hex": "0000005a7b2276223a322c2274797065223a22657272222c226964223a227031222c227061796c6f6164223a7b22636f6465223a22706169725f6661696c6564222c226d657373616765223a2270616972696e67206661696c6564227d7d"
    },
    {
      "name": "err_pair_rejected",
