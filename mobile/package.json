{
  "name": "lola-mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Lola's mobile companion: a Capacitor shell around the desktop app's Svelte component library, talking to the daemon's remote listener through a native transport plugin.",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode production",
    "build:dev": "vite build --minify false --mode development",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "npm run build:plugin && npm run build && cap sync ios",
    "ios": "npm run sync && cap open ios",
    "build:plugin": "npm --prefix plugins/lola-transport run build",
    "daemon": "../contrib/lola-remote-dev.sh",
    "daemon:info": "../contrib/lola-remote-dev.sh --info",
    "ios:sim": "npm run sync && cap run ios --target=simulator"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "lola-transport": "file:./plugins/lola-transport"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/svelte": "^5.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "jsdom": "^25.0.0",
    "svelte": "^5.46.4",
    "svelte-check": "^4.4.8",
    "tailwindcss": "^4.1.0",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^8.0.5",
    "vitest": "^3.0.0"
  }
}
