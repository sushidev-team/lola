+describe("DialogContent design tokens", () => {
+  test("uses the scrim and dialog shadow tokens", () => {
+    const dialog = openDialog();
+    expect(dialog.className).toContain("[box-shadow:var(--shadow-dialog)]");
+    expect(dialog.className).not.toContain("shadow-lg");
+    const overlay = document.querySelector(".bg-overlay-scrim");
+    expect(overlay).not.toBeNull();
+    expect(document.querySelector(".bg-black\\/80")).toBeNull();
+  });
+});
